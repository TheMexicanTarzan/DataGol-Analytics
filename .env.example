# Copy this file to .env and fill in your keys.
# .env is git-ignored and must never be committed.

# API-Football v3 key (https://www.api-football.com/)
# Primary data source for player stats, schedules, and live lineups.
API_FOOTBALL_KEY=your_api_football_key_here

# The Odds API key (https://the-odds-api.com/) — optional, for live betting odds
ODDS_API_KEY=your_odds_api_key_here
